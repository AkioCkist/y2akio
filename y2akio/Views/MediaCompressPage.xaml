<Page
    x:Class="y2akio.Views.MediaCompressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,8,24,24" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="1000" HorizontalAlignment="Center" Spacing="20">

            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,24,0,8">
                <TextBlock Text="Media Compress" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F58AFB" Offset="0" />
                            <GradientStop Color="#F25EE7" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Compress images and videos efficiently powered by FFmpeg"
                           Opacity="0.7" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Main Control Card -->
            <Border Padding="20" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="20">

                    <!-- Grid chính chứa 2 cột -->
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Drag & Drop + Preview Comparison -->
                        <StackPanel Grid.Column="0" Spacing="16">
                            <TextBlock Text="Source File" Opacity="0.7" FontSize="12" />

                            <!-- Drag and Drop Dropzone -->
                            <Border CornerRadius="8" Height="140"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="32" Opacity="0.8" HorizontalAlignment="Center" />
                                        <TextBlock Text="Drag and drop image or video here" Opacity="0.7" FontSize="13" TextAlignment="Center" />
                                        <Button x:Name="BrowseButton" Content="Browse File..." Click="BrowseButton_Click" Height="32" Padding="16,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Before vs After Comparison Grid -->
                            <TextBlock Text="Comparison Preview" Opacity="0.7" FontSize="12" Margin="0,8,0,0" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Original -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Original" Opacity="0.6" FontSize="11" HorizontalAlignment="Center"/>
                                    <Border CornerRadius="8" Height="160"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Image x:Name="OriginalImage" Stretch="Uniform" Margin="4" />
                                    </Border>
                                    <TextBlock x:Name="OriginalInfo" Text="No file selected" Opacity="0.8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Compressed -->
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Compressed" Opacity="0.6" FontSize="11" HorizontalAlignment="Center"/>
                                    <Border CornerRadius="8" Height="160"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Image x:Name="CompressedImage" Stretch="Uniform" Margin="4" />
                                    </Border>
                                    <TextBlock x:Name="CompressedInfo" Text="Waiting..." Opacity="0.8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Right Column: Settings -->
                        <StackPanel Grid.Column="1" Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Media Type" Opacity="0.7" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="VideoFormatToggle" Grid.Column="0" Content="Video"
                                                  IsChecked="True" Click="MediaTypeToggle_Click" HorizontalAlignment="Stretch" />
                                    <ToggleButton x:Name="ImageFormatToggle" Grid.Column="1" Content="Image"
                                                  Click="MediaTypeToggle_Click" HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>

                            <!-- Video Options -->
                            <StackPanel x:Name="VideoOptionsPanel" Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Video Codec Algorithm" Opacity="0.7" FontSize="12" />
                                    <ComboBox x:Name="VideoCodecComboBox" HorizontalAlignment="Stretch" SelectedIndex="1">
                                        <ComboBoxItem Content="H.264 (Standard)" Tag="h264" />
                                        <ComboBoxItem Content="H.265 / HEVC (Best Compression)" Tag="hevc" />
                                        <ComboBoxItem Content="AV1 (Next-Gen, Smallest Size)" Tag="av1" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- GPU Acceleration -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Hardware Acceleration (GPU)" Opacity="0.7" FontSize="12" />
                                    <ComboBox x:Name="HwAccelComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                        <ComboBoxItem Content="Auto (Detect &amp; Fallback to CPU)" Tag="auto" />
                                        <ComboBoxItem Content="NVIDIA (NVENC)" Tag="nvenc" />
                                        <ComboBoxItem Content="Intel (QuickSync)" Tag="qsv" />
                                        <ComboBoxItem Content="AMD (AMF)" Tag="amf" />
                                        <ComboBoxItem Content="None (CPU Only)" Tag="cpu" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Video Quality (CRF/CQ)" Opacity="0.7" FontSize="12" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="VideoQualityValueText" Text="28" Opacity="0.8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="VideoQualitySlider" Minimum="18" Maximum="35" Value="28" ValueChanged="VideoQualitySlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Image Options -->
                            <StackPanel x:Name="ImageOptionsPanel" Spacing="12" Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Output Format" Opacity="0.7" FontSize="12" />
                                    <ComboBox x:Name="ImageFormatComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                        <ComboBoxItem Content="WebP (High Efficiency)" Tag="webp" />
                                        <ComboBoxItem Content="JPEG (Optimized)" Tag="jpeg" />
                                        <ComboBoxItem Content="PNG (Lossless)" Tag="png" />
                                        <ComboBoxItem Content="GIF (Animated/Static)" Tag="gif" />
                                        <ComboBoxItem Content="BMP (Uncompressed)" Tag="bmp" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Image Quality" Opacity="0.7" FontSize="12" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="ImageQualityValueText" Text="80%" Opacity="0.8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="ImageQualitySlider" Minimum="10" Maximum="100" Value="80" ValueChanged="ImageQualitySlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Output Directory -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Output Folder" Opacity="0.7" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SaveLocationTextBox" Grid.Column="0" IsReadOnly="True" Height="34" VerticalAlignment="Center" />
                                    <Button x:Name="ChooseSaveFolderButton" Grid.Column="1" Content="Choose Folder"
                                            Click="ChooseSaveFolderButton_Click" Height="36" />
                                </Grid>
                            </StackPanel>

                            <!-- Actions & Progress Bar -->
                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed"
                                             Foreground="{ThemeResource PrimaryActionButtonBackground}" />
                                <TextBlock x:Name="StatusText" Opacity="0.6" FontSize="12" Visibility="Collapsed" HorizontalAlignment="Center" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="CompressButton" Grid.Column="0" Content="Start Compression" Height="40"
                                            HorizontalAlignment="Stretch" Style="{StaticResource PrimaryActionButtonStyle}" Click="CompressButton_Click" />
                                    <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Height="40"
                                            Visibility="Collapsed" Click="CancelButton_Click" />
                                </Grid>
                            </StackPanel>

                            <!-- Terminal Log -->
                            <StackPanel x:Name="TerminalPanel" Spacing="6" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock Text="Engine Execution Log" Opacity="0.7" FontSize="12" />
                                <Border CornerRadius="8" Height="140"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Background="#1E1E1E">
                                    <ScrollViewer x:Name="LogScrollViewer" Padding="10" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollMode="Auto"
                                                  HorizontalScrollMode="Disabled">
                                        <TextBlock x:Name="LogTextBlock" FontFamily="Consolas" FontSize="11" Foreground="#4ADE80"
                                                   TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Grid>

                    <!-- InfoBar - nằm ngoài Grid -->
                    <InfoBar x:Name="InfoBar" IsOpen="False" IsClosable="True" />

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>