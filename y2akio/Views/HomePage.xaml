<Page
    x:Class="y2akio.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:y2akio"
    xmlns:models="using:y2akio.Models"
    xmlns:thumbnails="using:y2akio.Helpers">

    <!-- Nội dung chính -->
    <ScrollViewer Padding="24,8,24,24" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="1000" HorizontalAlignment="Center" Spacing="20">

            <!-- Header / logo -->
            <StackPanel HorizontalAlignment="Center" Spacing="20" Margin="0,24,0,24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <Image Source="ms-appx:///Assets/mainLogo.png"
                           Height="150"
                           Stretch="Uniform"
                           VerticalAlignment="Center">
                        <Image.Shadow>
                            <ThemeShadow />
                        </Image.Shadow>
                    </Image>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Y2" FontSize="42" FontWeight="Black" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="AKIO" FontSize="42" FontWeight="Black" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F58AFB" Offset="0" />
                                    <GradientStop Color="#F25EE7" Offset="1" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <TextBlock x:Name="SubtitleText"
                           Text="Media downloader powered by yt-dlp"
                           Opacity="0.7"
                           FontSize="14"
                           VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- URL input row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UrlTextBox"
                         Grid.Column="0"
                         PlaceholderText="Paste YouTube (or other site) link here..."
                         Height="34"
                         VerticalAlignment="Center"
                         KeyDown="UrlTextBox_KeyDown" />

                <Button x:Name="AnalyzeButton"
                        Grid.Column="1"
                        Content="Analyze"
                        Height="36"
                        MinWidth="96"
                        Padding="16,0"
                        Click="AnalyzeButton_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}" />
            </Grid>

            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" Title="Couldn't analyze that link" />
            <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" Title="Download complete" IsClosable="True" />
            <ProgressRing x:Name="AnalyzingRing" IsActive="False" HorizontalAlignment="Center" Width="32" Height="32" />

            <!-- Analyzed video + download options -->
            <Grid x:Name="OptionsPanel" Visibility="Collapsed" ColumnSpacing="24" Padding="20"
                  CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: thumbnail + title -->
                <StackPanel Grid.Column="0" Spacing="10">
                    <Grid CornerRadius="8" Height="200">
                        <Image x:Name="ThumbnailImage" Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Background="#AA000000" CornerRadius="4" Padding="6,2" Margin="8">
                            <TextBlock x:Name="DurationText" Foreground="White" FontSize="12" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="VideoTitleText" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock x:Name="UploaderText" Opacity="0.6" />
                </StackPanel>

                <!-- Right: options -->
                <StackPanel Grid.Column="1" Spacing="14">
                    <TextBlock x:Name="DownloadOptionsTitle" Text="Download Options" FontSize="18" FontWeight="SemiBold" />

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="FileFormatLabel" Text="File Format" Opacity="0.7" FontSize="12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="VideoFormatToggle" Grid.Column="0" Content="Video (MP4)"
                                          IsChecked="True" Click="FileFormatToggle_Click" HorizontalAlignment="Stretch" />
                            <ToggleButton x:Name="AudioFormatToggle" Grid.Column="1" Content="Audio (Music)"
                                          Click="FileFormatToggle_Click" HorizontalAlignment="Stretch" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="QualityLabel" Text="Quality" Opacity="0.7" FontSize="12" />
                        <ComboBox x:Name="QualityComboBox" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel x:Name="ContainerFormatPanel" Spacing="6">
                        <TextBlock x:Name="VideoFormatLabel" Text="Video Format" Opacity="0.7" FontSize="12" />
                        <ComboBox x:Name="ContainerComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <x:String>MP4</x:String>
                            <x:String>MKV</x:String>
                            <x:String>WEBM</x:String>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="CodecPanel" Spacing="6">
                        <TextBlock x:Name="VideoCodecLabel" Text="Video Codec" Opacity="0.7" FontSize="12" />
                        <ComboBox x:Name="VideoCodecComboBox" HorizontalAlignment="Stretch" SelectedIndex="0"
                                  SelectionChanged="VideoCodecComboBox_SelectionChanged">
                            <ComboBoxItem Content="Auto" Tag="auto" />
                            <ComboBoxItem Content="H.264 (AVC)" Tag="h264" />
                            <ComboBoxItem Content="HEVC (H.265)" Tag="hevc" />
                            <ComboBoxItem Content="AV1" Tag="av1" />
                            <ComboBoxItem Content="VP9" Tag="vp9" />
                            <ComboBoxItem Content="MPEG-4 (Part 2)" Tag="mpeg4" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="AudioFormatPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock x:Name="AudioFormatLabel" Text="Audio Format" Opacity="0.7" FontSize="12" />
                        <ComboBox x:Name="AudioFormatComboBox" HorizontalAlignment="Stretch" SelectedIndex="0"
                                  SelectionChanged="AudioFormatComboBox_SelectionChanged">
                            <ComboBoxItem Content="MP3" Tag="mp3" />
                            <ComboBoxItem Content="M4A (AAC)" Tag="m4a" />
                            <ComboBoxItem Content="AAC" Tag="aac" />
                            <ComboBoxItem Content="FLAC (Lossless)" Tag="flac" />
                            <ComboBoxItem Content="Opus" Tag="opus" />
                            <ComboBoxItem Content="Vorbis (OGG)" Tag="vorbis" />
                            <ComboBoxItem Content="WAV (Lossless)" Tag="wav" />
                            <ComboBoxItem Content="ALAC (Lossless)" Tag="alac" />
                            <ComboBoxItem Content="WMA" Tag="wma" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="FileNamePrefixLabel" Text="File name prefix" Opacity="0.7" FontSize="12" />
                        <CheckBox x:Name="PrefixDateTimeCheck" Content="Download date + time" />
                        <CheckBox x:Name="PrefixChannelCheck" Content="Channel name" />
                        <CheckBox x:Name="IncludeTitleCheck" Content="Video title" IsChecked="True" />
                        <StackPanel x:Name="SubtitleSection" Spacing="0">
                            <CheckBox x:Name="SubtitlesCheck" Content="Download subtitles"
                                      Checked="SubtitlesCheck_Toggled" Unchecked="SubtitlesCheck_Toggled" />

                            <Border x:Name="SubtitleOptionsPanel" Visibility="Collapsed" CornerRadius="8"
                                    Padding="12,10" Margin="0,4,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="SubtitleOptionsTitle" Text="Subtitle Options" FontSize="13" FontWeight="SemiBold" />

                                    <RadioButtons x:Name="SubtitleModeRadio" SelectedIndex="0" MaxColumns="1">
                                        <RadioButton x:Name="SubtitleEmbedRadio" Content="Embed into video file" IsChecked="True" />
                                        <RadioButton x:Name="SubtitleSeparateRadio" Content="Save as separate file" />
                                    </RadioButtons>

                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="IncludeTracksLabel" Text="Include tracks" Opacity="0.7" FontSize="12" />
                                        <CheckBox x:Name="SubtitleManualCheck" Content="Author-uploaded subs"
                                                  IsChecked="True" Checked="SubtitleSource_Changed" Unchecked="SubtitleSource_Changed" />
                                        <CheckBox x:Name="SubtitleAutoCheck" Content="Auto-generated (YouTube)"
                                                  Checked="SubtitleSource_Changed" Unchecked="SubtitleSource_Changed" />
                                    </StackPanel>

                                    <StackPanel x:Name="ManualLanguagePanel" Spacing="4" Margin="20,0,0,0">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="SubtitleLanguageComboBox" Grid.Column="0" HorizontalAlignment="Stretch" />
                                            <Button x:Name="ManualSelectAllButton" Grid.Column="1" Content="Select all"
                                                    FontSize="12" Click="ManualSelectAllButton_Click" />
                                            <Button x:Name="ManualDeselectAllButton" Grid.Column="2" Content="Deselect all"
                                                    FontSize="12" Click="ManualDeselectAllButton_Click" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="AutoLanguagePanel" Spacing="4" Margin="20,0,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="AutoLanguagesLabel" Grid.Column="0" Text="Languages" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button x:Name="AutoSelectAllButton" Content="Select all"
                                                        FontSize="12" Click="AutoSelectAllButton_Click" />
                                                <Button x:Name="AutoDeselectAllButton" Content="Deselect all"
                                                        FontSize="12" Click="AutoDeselectAllButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <Border CornerRadius="6" MaxHeight="170"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <ScrollViewer>
                                                <ItemsControl x:Name="AutoLanguageList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:SubtitleSelection">
                                                            <CheckBox Content="{x:Bind Display}" Margin="4,2"
                                                                      IsChecked="{x:Bind Selected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="SubtitleFormatLabel" Text="Subtitle format" Opacity="0.7" FontSize="12" />
                                        <ComboBox x:Name="SubtitleFormatComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                            <ComboBoxItem Content="SRT" />
                                            <ComboBoxItem Content="VTT" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Video save location (visible when Video format is selected) -->
                    <StackPanel x:Name="VideoSaveLocationRow" Spacing="6">
                        <TextBlock x:Name="VideoSaveLocationLabel" Text="Video Save Location" Opacity="0.7" FontSize="12" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VideoSaveLocationTextBox" Grid.Column="0" IsReadOnly="True" />
                            <Button x:Name="ChooseVideoFolderButton" Grid.Column="1" Content="Choose Folder"
                                    Click="ChooseVideoFolderButton_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- Audio save location (visible when Audio format is selected) -->
                    <StackPanel x:Name="AudioSaveLocationRow" Spacing="6" Visibility="Collapsed">
                        <TextBlock x:Name="AudioSaveLocationLabel" Text="Audio Save Location" Opacity="0.7" FontSize="12" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AudioSaveLocationTextBox" Grid.Column="0" IsReadOnly="True" />
                            <Button x:Name="ChooseAudioFolderButton" Grid.Column="1" Content="Choose Folder"
                                    Click="ChooseAudioFolderButton_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ExtraOptionsLabel" Text="Extra Options" Opacity="0.7" FontSize="12" />
                        <CheckBox x:Name="EmbedMetadataCheck" Content="Embed full Metadata (Title, Artist...)" IsChecked="True" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ThumbnailLabel" Text="Thumbnail" Opacity="0.7" FontSize="12" />
                        <ComboBox x:Name="ThumbnailComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <x:String>Embed into media file</x:String>
                            <x:String>Save alongside file</x:String>
                            <x:String>Don't download</x:String>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="DownloadNowButton"
                            Content="Download Now"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Click="DownloadNowButton_Click" />

                    <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100"
                                 Foreground="{ThemeResource PrimaryActionButtonBackground}"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="DownloadStatusText" Opacity="0.6" FontSize="12" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- Playlist -->
            <StackPanel x:Name="PlaylistPanel" Visibility="Collapsed" Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="PlaylistTitleText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PlaylistMetaText" Opacity="0.6" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="DownloadPlaylistButton" Content="Download Selected"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Click="DownloadPlaylistButton_Click" Padding="14,8" />
                        </StackPanel>
                </Grid>

                <Border CornerRadius="12" Padding="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ListView x:Name="PlaylistListView"
                              MaxHeight="420"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="PlaylistListView_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistEntry">
                                <Grid ColumnSpacing="12" Padding="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                              IsChecked="{x:Bind Selected, Mode=TwoWay}"
                                              Checked="PlaylistEntryCheckBox_Changed"
                                              Unchecked="PlaylistEntryCheckBox_Changed" />

                                    <Border Grid.Column="1" Width="120" Height="68" CornerRadius="6"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Image Stretch="UniformToFill"
                                               Source="{x:Bind thumbnails:ThumbnailHelper.ToBitmap(ThumbnailUrl)}" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxLines="2" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{x:Bind DurationDisplay}" Opacity="0.6"
                                               FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <!-- Gallery: TikTok photo posts, Facebook / Instagram posts + stories -->
            <Grid x:Name="GalleryPanel" Visibility="Collapsed" RowSpacing="16" Padding="20"
                  CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: post info + selection shortcuts -->
                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="#33F25EE7" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="GalleryTitleText" FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="GalleryMetaText" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="GallerySelectAllButton" Content="Select all" FontSize="12"
                                Click="GallerySelectAllButton_Click" />
                        <Button x:Name="GalleryDeselectAllButton" Content="Deselect all" FontSize="12"
                                Click="GalleryDeselectAllButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Gallery: click an item to (de)select it, double-click to view it full size -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock x:Name="GalleryHint" Opacity="0.6" FontSize="12"
                               Text="Click items to select them · double-click to view full size" />
                    <Border CornerRadius="8" Padding="4"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <GridView x:Name="GalleryGrid"
                                  MaxHeight="560"
                                  SelectionMode="Multiple"
                                  IsMultiSelectCheckBoxEnabled="True"
                                  SelectionChanged="GalleryGrid_SelectionChanged"
                                  DoubleTapped="GalleryGrid_DoubleTapped">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaGalleryItem">
                                    <Grid Width="172" Height="230" CornerRadius="6"
                                          Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <ProgressRing Width="24" Height="24" IsActive="True"
                                                      Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE783;" FontFamily="Segoe Fluent Icons" FontSize="22" Opacity="0.5"
                                                  Visibility="{x:Bind FailedVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                Background="#AA000000" CornerRadius="4" Padding="6,2" Margin="6">
                                            <TextBlock Text="{x:Bind IndexDisplay}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                Background="#AA000000" CornerRadius="4" Padding="6,2" Margin="6"
                                                Visibility="{x:Bind SizeVisibility}">
                                            <TextBlock Text="{x:Bind SizeDisplay}" Foreground="White" FontSize="11" />
                                        </Border>
                                        <Border Width="44" Height="44" CornerRadius="22" Background="#99000000"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{x:Bind VideoBadgeVisibility}">
                                            <FontIcon Glyph="&#xF5B0;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                                      Foreground="White" Margin="3,0,0,0" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Border>
                </StackPanel>

                <!-- Footer toolbar: destination on the left, format + actions on the right -->
                <StackPanel Grid.Row="2" Spacing="14">
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Destination: click to change -->
                        <Button x:Name="ChooseGalleryFolderButton" Grid.Column="0" Height="36" Padding="10,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Click="ChooseGalleryFolderButton_Click">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="16" Opacity="0.8" />
                                <TextBlock x:Name="GallerySaveLocationText" Grid.Column="1" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Opacity="0.8" />
                            </Grid>
                        </Button>

                        <ComboBox x:Name="GallerySaveModeComboBox" Grid.Column="1" Height="36" MinWidth="170"
                                  SelectedIndex="0" VerticalAlignment="Center">
                            <ComboBoxItem x:Name="GallerySaveFolderItem" Content="Images in a folder" />
                            <ComboBoxItem x:Name="GallerySaveZipItem" Content="One ZIP file" />
                        </ComboBox>

                        <Button x:Name="GalleryDownloadAllButton" Grid.Column="2" Content="Download All"
                                Height="36" MinWidth="130" Padding="16,0"
                                Click="GalleryDownloadAllButton_Click" />

                        <Button x:Name="GalleryDownloadSelectedButton" Grid.Column="3" Content="Download Selected"
                                Height="36" MinWidth="170" Padding="16,0"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Click="GalleryDownloadSelectedButton_Click" />
                    </Grid>

                    <StackPanel x:Name="GalleryProgressPanel" Spacing="6" Visibility="Collapsed">
                        <ProgressBar x:Name="GalleryProgressBar" Minimum="0" Maximum="100"
                                     Foreground="{ThemeResource PrimaryActionButtonBackground}" />
                        <TextBlock x:Name="GalleryStatusText" Opacity="0.6" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Download log -->
            <StackPanel x:Name="LogPanel" Visibility="Collapsed" Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DownloadLogTitle" Grid.Column="0" Text="Download Log" FontSize="18" FontWeight="SemiBold" />
                    <HyperlinkButton x:Name="ClearLogButton" Grid.Column="1" Content="Clear" Click="ClearLogButton_Click" />
                </Grid>
                <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="LogScrollViewer" MaxHeight="280" Padding="12"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogTextBlock" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Download history -->
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DownloadHistoryTitle" Grid.Column="0" Text="Download History" FontSize="18" FontWeight="SemiBold" />
                    <HyperlinkButton x:Name="ClearHistoryButton" Grid.Column="1" Content="Clear All" Click="ClearHistoryButton_Click" />
                </Grid>

                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadHistoryItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                            Background="#332B7FD1" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind KindGlyph}" FontFamily="Segoe Fluent Icons" FontSize="16" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="&#xE768;" FontFamily="Segoe Fluent Icons"
                                                Click="PlayHistoryItem_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Play" />
                                        <Button Content="&#xE8C8;" FontFamily="Segoe Fluent Icons"
                                                Click="CopyPathHistoryItem_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Copy path" />
                                        <Button Content="&#xE8DA;" FontFamily="Segoe Fluent Icons"
                                                Click="OpenFolderHistoryItem_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Open folder" />
                                        <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons"
                                                Click="DeleteHistoryItem_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Delete"
                                                Background="#B3E23636" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
