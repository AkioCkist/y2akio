<Page
    x:Class="y2akio.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,16,32,40" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center" Spacing="4">

            <!-- ── Page title ── -->
            <TextBlock x:Name="PageTitle"
                       Text="Settings"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,8,0,20" />

            <!-- ══════════════ LANGUAGE ══════════════ -->
            <TextBlock x:Name="LangSectionHeader"
                       Text="Language"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,0,0,4" />

            <Border CornerRadius="8"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="LanguageLabel"
                                   Text="Display language"
                                   FontSize="14" />
                        <TextBlock x:Name="LanguageDesc"
                                   Text="Sets the language for the entire application"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <RadioButton x:Name="LangEnRadio"
                                     Content="English"
                                     GroupName="AppLanguage"
                                     Checked="LangRadio_Checked" />
                        <RadioButton x:Name="LangViRadio"
                                     Content="Tiếng Việt"
                                     GroupName="AppLanguage"
                                     Checked="LangRadio_Checked" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════ APPEARANCE ══════════════ -->
            <TextBlock x:Name="AppearanceSectionHeader"
                       Text="Appearance"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,4" />

            <Border CornerRadius="8"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ThemeLabel"
                                   Text="App theme"
                                   FontSize="14" />
                        <TextBlock x:Name="ThemeDesc"
                                   Text="Choose Light, Dark, or follow the Windows system setting"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </StackPanel>

                    <!-- Three theme radio buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <RadioButton x:Name="ThemeLightRadio"
                                     Tag="Light"
                                     GroupName="AppTheme"
                                     Checked="ThemeRadio_Checked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE706;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="ThemeLightText" Text="Light" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ThemeDarkRadio"
                                     Tag="Dark"
                                     GroupName="AppTheme"
                                     Checked="ThemeRadio_Checked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE708;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="ThemeDarkText" Text="Dark" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ThemeSystemRadio"
                                     Tag="System"
                                     GroupName="AppTheme"
                                     Checked="ThemeRadio_Checked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE770;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="ThemeSystemText" Text="System default" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════════════ DOWNLOAD LOCATIONS ══════════════ -->
            <TextBlock x:Name="DownloadSectionHeader"
                       Text="Download"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,4" />

            <!-- Video folder row (top of group) -->
            <Border CornerRadius="8,8,0,0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,1,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="VideoFolderTitle"
                                   Text="Video save folder"
                                   FontSize="14" />
                        <TextBlock x:Name="VideoFolderDesc"
                                   Text="Default location for video downloads"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </StackPanel>

                    <TextBox x:Name="VideoFolderBox"
                             Grid.Column="1"
                             IsReadOnly="True"
                             VerticalAlignment="Center" />

                    <Button x:Name="BrowseVideoButton"
                            Grid.Column="2"
                            Content="Browse..."
                            VerticalAlignment="Center"
                            Click="BrowseVideoButton_Click" />
                </Grid>
            </Border>

            <!-- Separator line between card rows -->
            <Border Height="1"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                    HorizontalAlignment="Stretch"
                    Margin="16,0" />

            <!-- Audio folder row (bottom of group) -->
            <Border CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="AudioFolderTitle"
                                   Text="Audio save folder"
                                   FontSize="14" />
                        <TextBlock x:Name="AudioFolderDesc"
                                   Text="Default location for audio downloads"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </StackPanel>

                    <TextBox x:Name="AudioFolderBox"
                             Grid.Column="1"
                             IsReadOnly="True"
                             VerticalAlignment="Center" />

                    <Button x:Name="BrowseAudioButton"
                            Grid.Column="2"
                            Content="Browse..."
                            VerticalAlignment="Center"
                            Click="BrowseAudioButton_Click" />
                </Grid>
            </Border>

            <!-- ══════════════ ABOUT ══════════════ -->
            <TextBlock x:Name="AboutSectionHeader"
                       Text="About"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,4" />

            <Border CornerRadius="8"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Y2Akio" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Media downloader powered by yt-dlp"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </StackPanel>

                    <TextBlock x:Name="VersionText"
                               Grid.Column="1"
                               Text="v1.0.0"
                               FontSize="12"
                               Opacity="0.45"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
