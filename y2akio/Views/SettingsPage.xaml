<Page
    x:Class="y2akio.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,16,32,40" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center" Spacing="4">

            <!-- ── Page title ── -->
            <TextBlock x:Name="PageTitle"
                       Text="Settings"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,8,0,20" />

            <!-- ══════════════ LANGUAGE ══════════════ -->
            <TextBlock x:Name="LangSectionHeader"
                       Text="Language"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,0,0,4" />

            <Border CornerRadius="8"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="LanguageLabel"
                                   Text="Display language"
                                   FontSize="14" />
                        <TextBlock x:Name="LanguageDesc"
                                   Text="Sets the language for the entire application"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <RadioButton x:Name="LangEnRadio"
                                     Content="English"
                                     GroupName="AppLanguage"
                                     Checked="LangRadio_Checked" />
                        <RadioButton x:Name="LangViRadio"
                                     Content="Tiếng Việt"
                                     GroupName="AppLanguage"
                                     Checked="LangRadio_Checked" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════ APPEARANCE ══════════════ -->
            <TextBlock x:Name="AppearanceSectionHeader"
                       Text="Appearance"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,4" />

            <Border CornerRadius="8"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ThemeLabel"
                                   Text="App theme"
                                   FontSize="14" />
                        <TextBlock x:Name="ThemeDesc"
                                   Text="Choose Light, Dark, or follow the Windows system setting"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </StackPanel>

                    <!-- Three theme radio buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <RadioButton x:Name="ThemeLightRadio"
                                     Tag="Light"
                                     GroupName="AppTheme"
                                     Checked="ThemeRadio_Checked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE706;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="ThemeLightText" Text="Light" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ThemeDarkRadio"
                                     Tag="Dark"
                                     GroupName="AppTheme"
                                     Checked="ThemeRadio_Checked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE708;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="ThemeDarkText" Text="Dark" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ThemeSystemRadio"
                                     Tag="System"
                                     GroupName="AppTheme"
                                     Checked="ThemeRadio_Checked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE770;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="ThemeSystemText" Text="System default" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════════════ DOWNLOAD LOCATIONS ══════════════ -->
            <TextBlock x:Name="DownloadSectionHeader"
                       Text="Download"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,4" />

            <!-- Video folder row (top of group) -->
            <Border CornerRadius="8,8,0,0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,1,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="VideoFolderTitle"
                                   Text="Video save folder"
                                   FontSize="14" />
                        <TextBlock x:Name="VideoFolderDesc"
                                   Text="Default location for video downloads"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </StackPanel>

                    <TextBox x:Name="VideoFolderBox"
                             Grid.Column="1"
                             IsReadOnly="True"
                             VerticalAlignment="Center" />

                    <Button x:Name="BrowseVideoButton"
                            Grid.Column="2"
                            Content="Browse..."
                            VerticalAlignment="Center"
                            Click="BrowseVideoButton_Click" />
                </Grid>
            </Border>

            <!-- Separator line between card rows -->
            <Border Height="1"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                    HorizontalAlignment="Stretch"
                    Margin="16,0" />

            <!-- Audio folder row (middle of group) -->
            <Border CornerRadius="0,0,0,0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="AudioFolderTitle"
                                   Text="Audio save folder"
                                   FontSize="14" />
                        <TextBlock x:Name="AudioFolderDesc"
                                   Text="Default location for audio downloads"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </StackPanel>

                    <TextBox x:Name="AudioFolderBox"
                             Grid.Column="1"
                             IsReadOnly="True"
                             VerticalAlignment="Center" />

                    <Button x:Name="BrowseAudioButton"
                            Grid.Column="2"
                            Content="Browse..."
                            VerticalAlignment="Center"
                            Click="BrowseAudioButton_Click" />
                </Grid>
            </Border>

            <!-- Separator line between card rows -->
            <Border Height="1"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                    HorizontalAlignment="Stretch"
                    Margin="16,0" />

            <!-- Cookies row (bottom of group) — login-gated content; content encrypted at rest -->
            <Border CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="CookiesTitle"
                                   Text="Browser cookies (cookies.txt)"
                                   FontSize="14" />
                        <TextBlock x:Name="CookiesDesc"
                                   Text="Login-gated content (X/Twitter, private reels). Stored encrypted."
                                   FontSize="12"
                                   Opacity="0.6" />
                        <TextBlock x:Name="CookiesImportedStatus"
                                   Text="Imported · encrypted"
                                   FontSize="12"
                                   Opacity="0.85"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <Button x:Name="ImportCookiesButton"
                                Content="Import..."
                                Click="ImportCookiesButton_Click" />
                        <Button x:Name="DeleteCookiesButton"
                                Content="Delete"
                                Click="DeleteCookiesButton_Click"
                                Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════ DOWNLOAD MANAGER ══════════════ -->
            <TextBlock x:Name="ManagerSectionHeader"
                       Text="Download manager"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,24,0,4" />

            <Border CornerRadius="8,8,0,0" Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="MultiConnTitle" FontSize="14" />
                        <TextBlock x:Name="MultiConnDesc" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MultiConnectionToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="DownloadSetting_Changed" />
                </Grid>
            </Border>
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" Margin="16,0" />
            <Border CornerRadius="0" Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ConnectionsTitle" FontSize="14" />
                        <TextBlock x:Name="ConnectionsDesc" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                    <NumberBox x:Name="ConnectionsBox" Grid.Column="1" Minimum="1" Maximum="16" Width="140" SpinButtonPlacementMode="Inline" ValueChanged="DownloadNumber_Changed" />
                </Grid>
            </Border>
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" Margin="16,0" />
            <Border CornerRadius="0" Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ParallelTitle" FontSize="14" />
                        <TextBlock x:Name="ParallelDesc" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                    <NumberBox x:Name="ParallelBox" Grid.Column="1" Minimum="1" Maximum="10" Width="140" SpinButtonPlacementMode="Inline" ValueChanged="DownloadNumber_Changed" />
                </Grid>
            </Border>
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" Margin="16,0" />
            <Border CornerRadius="0" Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="SpeedLimitTitle" FontSize="14" />
                        <TextBlock x:Name="SpeedLimitDesc" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                    <NumberBox x:Name="SpeedLimitSettingBox" Grid.Column="1" Minimum="0" Maximum="1000000" Width="140" SpinButtonPlacementMode="Inline" ValueChanged="DownloadNumber_Changed" />
                </Grid>
            </Border>
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" Margin="16,0" />
            <Border CornerRadius="0" Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ResumeStartupTitle" FontSize="14" />
                        <TextBlock x:Name="ResumeStartupDesc" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ResumeOnStartupToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="DownloadSetting_Changed" />
                </Grid>
            </Border>
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" Margin="16,0" />
            <Border CornerRadius="0" Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ClipboardTitle" FontSize="14" />
                        <TextBlock x:Name="ClipboardDesc" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="WatchClipboardToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="DownloadSetting_Changed" />
                </Grid>
            </Border>
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" Margin="16,0" />
            <Border CornerRadius="0,0,8,8" Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="SiteFoldersTitle" FontSize="14" />
                        <TextBlock x:Name="SiteFoldersDesc" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SiteSubfoldersToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="DownloadSetting_Changed" />
                </Grid>
            </Border>

            <!-- ══════════════ ABOUT ══════════════ -->
            <TextBlock x:Name="AboutSectionHeader"
                       Text="About"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,4" />

            <Border CornerRadius="8"
                Padding="16,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Y2Akio" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Media downloader powered by yt-dlp"
                               FontSize="12"
                               Opacity="0.6" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            Spacing="8" 
                            VerticalAlignment="Center">
                        <!-- Text Version -->
                        <TextBlock x:Name="VersionText"
                               Text="v1.0.0"
                               FontSize="12"
                               Opacity="0.45"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                        <!-- Nút Facebook -->
                        <HyperlinkButton NavigateUri="https://www.facebook.com/danchoiteibuck"
                                     ToolTipService.ToolTip="Facebook"
                                     Padding="6"
                                     Width="32"
                                     Height="32">
                            <Image Source="{ThemeResource FacebookIconSource}"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform" />
                        </HyperlinkButton>

                        <!-- Nút GitHub -->
                        <HyperlinkButton NavigateUri="https://github.com/AkioCkist/y2akio"
                                     ToolTipService.ToolTip="GitHub"
                                     Padding="6"
                                     Width="32"
                                     Height="32">
                            <Image Source="{ThemeResource GitHubIconSource}"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform" />
                        </HyperlinkButton>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
