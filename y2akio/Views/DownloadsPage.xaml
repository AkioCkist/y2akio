<Page
    x:Class="y2akio.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:y2akio.Models"
    xmlns:helpers="using:y2akio.Helpers">

    <Grid Padding="32,16,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title + summary -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,28,0,4">
            <TextBlock x:Name="PageTitle" Text="Downloads" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Opacity="0.6" FontSize="13" />
        </StackPanel>

        <!-- Toolbar: queue commands -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ResumeAllButton" Grid.Column="0" Click="ResumeAllButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock x:Name="ResumeAllText" Text="Resume all" />
                </StackPanel>
            </Button>
            <Button x:Name="PauseAllButton" Grid.Column="1" Click="PauseAllButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE769;" FontSize="14" />
                    <TextBlock x:Name="PauseAllText" Text="Pause all" />
                </StackPanel>
            </Button>
            <Button x:Name="ClearFinishedButton" Grid.Column="2" Click="ClearFinishedButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock x:Name="ClearFinishedText" Text="Clear finished" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Queue options: speed limit, scheduled start, when done -->
        <Border Grid.Row="2" CornerRadius="8" Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="24" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock x:Name="SpeedLimitLabel" Text="Speed limit (KB/s, 0 = unlimited)" FontSize="12" Opacity="0.7" />
                    <NumberBox x:Name="SpeedLimitBox" Minimum="0" Maximum="1000000" SmallChange="256" LargeChange="1024"
                               SpinButtonPlacementMode="Compact" Width="220" ValueChanged="SpeedLimitBox_ValueChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock x:Name="ScheduleLabel" Text="Scheduled start" FontSize="12" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <CheckBox x:Name="ScheduleCheck" MinWidth="0" VerticalAlignment="Center"
                                  Checked="Schedule_Changed" Unchecked="Schedule_Changed" />
                        <TimePicker x:Name="ScheduleTimePicker" ClockIdentifier="24HourClock" MinWidth="180" IsEnabled="False"
                                    TimeChanged="ScheduleTimePicker_TimeChanged" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock x:Name="WhenDoneLabel" Text="When all downloads finish" FontSize="12" Opacity="0.7" />
                    <ComboBox x:Name="WhenDoneComboBox" Width="220" SelectionChanged="WhenDoneComboBox_SelectionChanged">
                        <ComboBoxItem x:Name="WhenDoneNothingItem" Tag="None" Content="Do nothing" />
                        <ComboBoxItem x:Name="WhenDoneSleepItem" Tag="Sleep" Content="Sleep" />
                        <ComboBoxItem x:Name="WhenDoneShutdownItem" Tag="Shutdown" Content="Shut down" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Jobs -->
        <Grid Grid.Row="3">
            <TextBlock x:Name="EmptyText" Text="No downloads yet." Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListView x:Name="JobsList" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,12,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadJob">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="12,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="112" Height="63" CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <Image Source="{x:Bind ThumbnailSource}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Opacity="0.8" />
                                        <TextBlock Text="{x:Bind PercentText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Opacity="0.8"
                                                   Visibility="{x:Bind PercentVisibility, Mode=OneWay}" />
                                        <TextBlock Text="·" FontSize="12" Opacity="0.5" />
                                        <TextBlock Text="{x:Bind Site}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="·" FontSize="12" Opacity="0.5" />
                                        <TextBlock Text="{x:Bind QualityLabel}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind SpeedLimitText, Mode=OneWay}" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,2,0,0"
                                                 Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                                                 ShowPaused="{x:Bind ProgressPaused, Mode=OneWay}"
                                                 ShowError="{x:Bind ProgressError, Mode=OneWay}" />
                                    <helpers:SegmentBar Segments="{x:Bind Segments, Mode=OneWay}" Total="{x:Bind SegmentsTotal, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" FontSize="12" Opacity="0.65"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               ToolTipService.ToolTip="{x:Bind DetailTooltip, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="&#xE769;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" Click="PauseJob_Click"
                                            Visibility="{x:Bind PauseVisibility, Mode=OneWay}" ToolTipService.ToolTip="Pause" />
                                    <Button Content="&#xE768;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" Click="ResumeJob_Click"
                                            Visibility="{x:Bind ResumeVisibility, Mode=OneWay}" ToolTipService.ToolTip="Resume" />
                                    <Button Content="&#xE8A5;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" Click="OpenFile_Click"
                                            Visibility="{x:Bind OpenVisibility, Mode=OneWay}" ToolTipService.ToolTip="Open" />
                                    <Button Content="&#xE838;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" Click="OpenFolder_Click"
                                            ToolTipService.ToolTip="Open folder" />
                                    <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" Click="CancelJob_Click"
                                            Visibility="{x:Bind CancelVisibility, Mode=OneWay}" ToolTipService.ToolTip="Cancel" />
                                    <Button Content="&#xE712;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" ToolTipService.ToolTip="More">
                                        <Button.Flyout>
                                            <MenuFlyout Opening="JobMenu_Opening">
                                                <MenuFlyoutItem Text="…" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
