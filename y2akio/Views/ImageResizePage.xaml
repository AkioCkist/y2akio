<Page
    x:Class="y2akio.Views.ImageResizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,8,24,24" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="1000" HorizontalAlignment="Center" Spacing="20">

            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,24,0,8">
                <TextBlock Text="Image Resize" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F58AFB" Offset="0" />
                            <GradientStop Color="#F25EE7" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Scale any image to a new size or format — PNG, JPEG, BMP, TIFF, GIF"
                           Opacity="0.7" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Main card -->
            <Border Padding="20" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="20">

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Source -->
                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Text="Source image" Opacity="0.7" FontSize="12" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FileNameText" Grid.Column="0" VerticalAlignment="Center"
                                           Text="No image selected" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="ChooseImageButton" Grid.Column="1" Content="Choose Image..."
                                        Click="ChooseImageButton_Click" />
                            </Grid>

                            <Border CornerRadius="8" Height="260"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <TextBlock x:Name="PreviewPlaceholder" Text="Preview"
                                               Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"
                                           Visibility="Collapsed" ImageOpened="PreviewImage_ImageOpened" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="SourceDimsText" Opacity="0.6" FontSize="12" />
                        </StackPanel>

                        <!-- Target -->
                        <StackPanel Grid.Column="1" Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Resize mode" Opacity="0.7" FontSize="12" />
                                <RadioButtons x:Name="ModeRadio" SelectedIndex="0" MaxColumns="2"
                                              SelectionChanged="ModeRadio_SelectionChanged">
                                    <RadioButton Content="By pixel" />
                                    <RadioButton Content="By percentage" />
                                </RadioButtons>
                            </StackPanel>

                            <StackPanel x:Name="PixelPanel" Spacing="6">
                                <TextBlock Text="Target size (pixels)" Opacity="0.7" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="TargetWidth" Grid.Column="0" Minimum="1" Maximum="20000"
                                               PlaceholderText="Width" SpinButtonPlacementMode="Inline" />
                                    <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" Opacity="0.6" />
                                    <NumberBox x:Name="TargetHeight" Grid.Column="2" Minimum="1" Maximum="20000"
                                               PlaceholderText="Height" SpinButtonPlacementMode="Inline" />
                                </Grid>
                                <CheckBox x:Name="KeepAspectCheck" Content="Keep aspect ratio" IsChecked="True" />
                                <TextBlock Text="With aspect ratio on, leave one box empty — the other is computed from the source."
                                           Opacity="0.5" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="PercentPanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="Scale percentage" Opacity="0.7" FontSize="12" />
                                <NumberBox x:Name="PercentScaleBox" Minimum="1" Maximum="5000" Value="50"
                                           HorizontalAlignment="Stretch" SpinButtonPlacementMode="Compact" />
                                <TextBlock Text="50 = half size · 200 = double · 100 = unchanged"
                                           Opacity="0.5" FontSize="11" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Output format" Opacity="0.7" FontSize="12" />
                                <ComboBox x:Name="FormatComboBox" HorizontalAlignment="Stretch" SelectedIndex="0"
                                          SelectionChanged="FormatComboBox_SelectionChanged">
                                    <ComboBoxItem Content="PNG" Tag="png" />
                                    <ComboBoxItem Content="JPEG" Tag="jpg" />
                                    <ComboBoxItem Content="BMP" Tag="bmp" />
                                    <ComboBoxItem Content="TIFF" Tag="tiff" />
                                    <ComboBoxItem Content="GIF" Tag="gif" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="QualityRow" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="JPEG / GIF quality" Opacity="0.7" FontSize="12" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="QualitySlider" Grid.Column="0" Minimum="1" Maximum="100"
                                            Value="92" ValueChanged="QualitySlider_ValueChanged" />
                                    <TextBlock x:Name="QualityValueText" Grid.Column="1" Text="92" VerticalAlignment="Center" Width="32" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Output file" Opacity="0.7" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputNameTextBox" Grid.Column="0" PlaceholderText="image_resized.png"
                                             TextChanged="OutputNameTextBox_TextChanged" />
                                    <Button x:Name="ChooseOutputFolderButton" Grid.Column="1" Content="Choose Folder"
                                            Click="ChooseOutputFolderButton_Click" />
                                </Grid>
                                <TextBlock x:Name="OutputFolderText" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Actions -->
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ResizeButton" Grid.Column="0" Content="Resize Image" Height="40"
                                    HorizontalAlignment="Stretch" Background="#1FBF83" Click="ResizeButton_Click" />
                            <ProgressRing x:Name="ResizeRing" Grid.Column="1" Width="32" Height="32"
                                          IsActive="False" VerticalAlignment="Center" />
                        </Grid>
                        <InfoBar x:Name="ResultBar" Severity="Success" IsOpen="False" IsClosable="True" />
                        <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
