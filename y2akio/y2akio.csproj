<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>y2akio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>

    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <!-- yt-dlp onedir build (yt-dlp_win.zip): yt-dlp.exe + _internal\. Not the onefile yt-dlp.exe,
         which unpacks itself to %TEMP% on every run and gets rescanned by antivirus on clean machines. -->
    <Content Include="bin\yt-dlp\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <!-- deno: JS runtime yt-dlp needs to solve YouTube's challenges (passed via the js-runtimes option). -->
    <Content Include="bin\deno\deno.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <Content Include="bin\ffmpeg-9.0.1-full_build\bin\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

  <!--
    WindowsAppSDK 2.4 self-contained deployment misses Microsoft.WindowsAppRuntime.Insights.Resource.dll.
    The runtime's resource loader needs that 34 KB satellite DLL (error-string formatting); without it the
    app fails at startup with "Unable to load resource dll. Microsoft.WindowsAppRuntime.Insights.Resource.dll"
    on machines that don't have the Windows App Runtime installed (dev machines mask it because the runtime
    is installed there). The SDK's payload target only copies component-package runtimes-framework folders,
    which don't include this file. Extract it from the runtime MSIX and deploy it next to the exe, alongside
    the rest of the self-contained payload. Remove this target if a future SDK ships the file itself.
  -->
  <Target Name="DeployWindowsAppRuntimeInsights"
          AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <PropertyGroup>
      <_WinsAppRuntimeArch>$(Platform)</_WinsAppRuntimeArch>
      <_WinsAppRuntimeArch Condition="'$(_WinsAppRuntimeArch)' == '' or '$(_WinsAppRuntimeArch)' == 'AnyCPU' or '$(_WinsAppRuntimeArch)' == 'Any CPU'">x64</_WinsAppRuntimeArch>
      <_WinsAppRuntimeArch Condition="'$(_WinsAppRuntimeArch)' == 'X64'">x64</_WinsAppRuntimeArch>
      <_WinsAppRuntimeArch Condition="'$(_WinsAppRuntimeArch)' == 'X86'">x86</_WinsAppRuntimeArch>
      <_WinsAppRuntimeArch Condition="'$(_WinsAppRuntimeArch)' == 'ARM64'">arm64</_WinsAppRuntimeArch>
    </PropertyGroup>
    <ItemGroup>
      <_WindowsAppRuntimeMsix Include="$(NuGetPackageRoot)microsoft.windowsappsdk.runtime\**\tools\MSIX\win10-$(_WinsAppRuntimeArch)\Microsoft.WindowsAppRuntime.2.msix" />
    </ItemGroup>
    <PropertyGroup>
      <_WinsAppRuntimeMsixPath>@(_WindowsAppRuntimeMsix)</_WinsAppRuntimeMsixPath>
      <_InsightsOut>$(IntermediateOutputPath)Microsoft.WindowsAppRuntime.Insights.Resource.dll</_InsightsOut>
    </PropertyGroup>
    <Exec Condition="'$(_WinsAppRuntimeMsixPath)' != '' and !Exists('$(_InsightsOut)')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Add-Type -AssemblyName System.IO.Compression.FileSystem; [System.IO.Directory]::CreateDirectory('$(IntermediateOutputPath)') | Out-Null; $z=[System.IO.Compression.ZipFile]::OpenRead('$(_WinsAppRuntimeMsixPath)'); $e=$z.GetEntry('Microsoft.WindowsAppRuntime.Insights.Resource.dll'); if($e){[System.IO.Compression.ZipFileExtensions]::ExtractToFile($e, '$(_InsightsOut)', $true)}; $z.Dispose()&quot;" />
    <ItemGroup Condition="Exists('$(_InsightsOut)')">
      <None Include="$(_InsightsOut)"
            CopyToOutputDirectory="PreserveNewest"
            Link="Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
    </ItemGroup>
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>B1701F601A84D97D89052395C2C8BF77DC769387</PackageCertificateThumbprint>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>
</Project>